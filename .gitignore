# Data (raw filings, processed text, and vector indexes are reproducible from the manifest)
data/raw/*
data/processed/*
data/indexes/*
data/chunks/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/indexes/.gitkeep

# Eval sets are committed (they are the labels); only the corpus is reproducible
!data/eval/*.jsonl
!data/eval/baseline.json

# Reports and notebooks
reports/
notebooks/.ipynb_checkpoints/

