# Copy to .env and fill in. Never commit .env.
# The model provider is your choice; the defaults run everything locally and free.

# ---------------------------------------------------------------------------
# Chat model. LLM_PROVIDER: openai_compatible | anthropic
#
#   a) Ollama on this machine (default)
#        LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
#   b) Ollama / vLLM / LM Studio / llama.cpp on another machine
#        LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://<host>:<port>/v1   LLM_API_KEY=<if the server wants one>
#   c) Hosted OpenAI-compatible API (OpenAI, OpenRouter, Groq, ...)
#        LLM_PROVIDER=openai_compatible  LLM_BASE_URL=<provider url>            LLM_API_KEY=<token>
#   d) Anthropic API
#        LLM_PROVIDER=anthropic          LLM_MODEL=claude-opus-5                LLM_API_KEY=<token>
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Embeddings. EMBED_PROVIDER: openai_compatible | sentence_transformers
# Kept separate from the chat model so a hosted chat model can use local embeddings.
EMBED_PROVIDER=openai_compatible
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
# Task prefixes for asymmetric embedding models. These are nomic-embed-text's;
# clear both for a model that does not use them.
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOCUMENT_PREFIX="search_document: "

# Per-request timeout in seconds. A cold local model can take a minute to load.
REQUEST_TIMEOUT_S=120

# Retrieval: dense | bm25 | hybrid | hybrid-filter | hybrid-rerank (ADR-008)
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_POOL=50
FUSION_K=60
INFER_FILTERS=true
RERANK_POOL=20

# Refuse when the best retrieved passage scores below this. 0 disables the check.
MIN_RETRIEVAL_SCORE=0.0

# Cap on a generated answer. Thinking-mode models need room before they write.
ANSWER_MAX_TOKENS=1024

# Answer prompt. 1 answers only from what a passage prints. 2 lets the model compute a
# growth rate, difference, ratio or share, on condition it writes the arithmetic on a
# CALC: line, which is then recomputed from the passages the operands cite. 2 is the only
# way to get an answer to a question whose number no filing prints, and with gpt-oss:20b it
# costs two of the 33 answerable questions on the regression gate.
# See docs/learning/hallucination-control.md.
ANSWER_PROMPT_VERSION=1

# Chunking: sizes are whitespace words, not model tokens
CHUNK_STRATEGY=section-aware
CHUNK_WORDS=350
CHUNK_OVERLAP_WORDS=60

# Vector store: chroma | faiss-flat | faiss-hnsw (ADR-010)
VECTOR_STORE=chroma
EMBED_DIMENSIONS=768

# SEC EDGAR fair-access policy requires a real contact in the User-Agent
EDGAR_USER_AGENT="quarterly-RAG your-name your-email@example.com"

# Langfuse (self-hosted, see infra/). Tracing is on only when the host and both keys are
# set; with any of them blank the pipeline uses a tracer that does nothing, so nothing here
# is required to answer a question. `make langfuse-up` creates the project and these keys
# on first boot from the LANGFUSE_INIT_* values below, so there is no clicking through a UI.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-quarterly-rag-local
LANGFUSE_SECRET_KEY=sk-lf-quarterly-rag-local

# First-boot bootstrap for the local stack. These are credentials for a container on your
# own machine that binds to localhost; they are not secrets shared with anyone, and they
# must match LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY above. Change them if you expose
# the stack beyond this machine, and then they do belong in .env and nowhere else.
LANGFUSE_INIT_ORG_ID=quarterly-rag
LANGFUSE_INIT_ORG_NAME=quarterly-RAG
LANGFUSE_INIT_PROJECT_ID=quarterly-rag
LANGFUSE_INIT_PROJECT_NAME=quarterly-RAG
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-quarterly-rag-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-quarterly-rag-local
LANGFUSE_INIT_USER_EMAIL=local@example.com
LANGFUSE_INIT_USER_NAME=Local
LANGFUSE_INIT_USER_PASSWORD=langfuse-local

# Paths
DATA_DIR=data
